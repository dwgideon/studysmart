generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @db.Uuid
  email                  String    @unique
  name                   String?
  xp                     Int       @default(0)
  stripeCustomerId       String?
  plan                   String?
  accountRole            String    @default("STUDENT")
  ageGroup               String    @default("UNKNOWN")
  roleVerificationStatus String    @default("NOT_REQUIRED")
  verifiedAt             DateTime?
  safetyStrikeCount      Int       @default(0)
  learningLockedUntil    DateTime?
  createdAt              DateTime  @default(now())

  flashcards              Flashcard[]
  sessions                StudySession[]
  streak                  StudyStreak?
  cardReviews             CardReview[]
  savedQuizzes            SavedQuiz[]
  notes                   Note[]
  learnerProfile          LearnerProfile?
  courses                 Course[]
  conceptMasteries        ConceptMastery[]
  masteryEvidence         MasteryEvidence[]
  tutorConversations      TutorConversation[]
  sourceMaterials         SourceMaterial[]
  classroomsTaught        Classroom[]              @relation("ClassroomTeacher")
  classroomMemberships    ClassroomMembership[]
  guardianLinks           GuardianStudent[]        @relation("GuardianLinks")
  guardians               GuardianStudent[]        @relation("StudentGuardians")
  guardianInvites         GuardianInvite[]
  assignmentsCreated      Assignment[]             @relation("AssignmentTeacher")
  assignmentSubmissions   AssignmentSubmission[]
  diagnosticAssessments   DiagnosticAssessment[]
  privacySettings         PrivacySettings?
  consentsGiven           ConsentRecord[]          @relation("ConsentActor")
  consentsFor             ConsentRecord[]          @relation("ConsentSubject")
  roleVerifications       RoleVerification[]
  safetyEvents            SafetyEvent[]
  safetyViolations        SafetyViolation[]
  safetyNotifications     SafetyNotification[]
  safetyContactPreference SafetyContactPreference?
  pushSubscriptions       PushSubscription[]
  dataRightsRequests      DataRightsRequest[]
  auditEvents             AuditEvent[]
  integrationConnections  IntegrationConnection[]
  aiInteractionTraces     AiInteractionTrace[]
  experimentAssignments   ExperimentAssignment[]
  experimentEvents        ExperimentEvent[]
  organizationsCreated    Organization[]           @relation("OrganizationCreator")
  organizationMemberships OrganizationMembership[]
  gameProfile             GameProfile?
  gameRuns                GameRun[]
  avatarItems             AvatarItemOwnership[]

  @@index([email])
}

model GameProfile {
  userId         String   @id @db.Uuid
  sparks         Int      @default(0)
  lifetimeSparks Int      @default(0)
  equippedHair   String   @default("hair_starter")
  equippedTop    String   @default("top_starter")
  equippedExtra  String   @default("extra_none")
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AvatarItemOwnership {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  itemId     String
  acquiredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
}

model GameRun {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @db.Uuid
  mode           String
  project        String?
  questions      Json
  answers        Json
  currentIndex   Int       @default(0)
  score          Int       @default(0)
  xpEarned       Int       @default(0)
  sparksEarned   Int       @default(0)
  rewardsEnabled Boolean   @default(true)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, completedAt])
}

model LearnerProfile {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @unique @db.Uuid
  gradeLevel          String
  primaryLearningGoal String?
  onboardingCompleted Boolean   @default(false)
  dailyReviewLimit    Int       @default(20)
  diagnosticCompleted Boolean   @default(false)
  lastDiagnosticAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gradeLevel])
}

model Course {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @db.Uuid
  name         String
  subject      String
  examDate     DateTime?
  learningGoal String?
  isPrimary    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySessions         StudySession[]
  concepts              Concept[]
  tutorConversations    TutorConversation[]
  savedQuizzes          SavedQuiz[]
  sourceMaterials       SourceMaterial[]
  diagnosticAssessments DiagnosticAssessment[]

  @@index([userId])
  @@index([userId, isPrimary])
  @@index([examDate])
}

model StudySession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @db.Uuid
  courseId         String?  @db.Uuid
  sourceMaterialId String?  @db.Uuid
  title            String?
  createdAt        DateTime @default(now())
  totalCards       Int      @default(0)
  correct          Int      @default(0)
  incorrect        Int      @default(0)
  completed        Boolean  @default(false)

  user           User            @relation(fields: [userId], references: [id])
  course         Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  sourceMaterial SourceMaterial? @relation(fields: [sourceMaterialId], references: [id], onDelete: SetNull)
  flashcards     Flashcard[]
  cardReviews    CardReview[]

  @@index([userId])
  @@index([courseId])
  @@index([sourceMaterialId])
  @@index([createdAt])
}

model Flashcard {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String  @db.Uuid
  sessionId String  @db.Uuid
  conceptId String? @db.Uuid

  question             String
  answer               String
  createdAt            DateTime  @default(now())
  nextReviewAt         DateTime  @default(now())
  lastReviewedAt       DateTime?
  intervalDays         Float     @default(0)
  easeFactor           Float     @default(2.5)
  scheduledReviewCount Int       @default(0)
  lapseCount           Int       @default(0)
  memoryStability      Float     @default(1)
  memoryDifficulty     Float     @default(5)
  targetRetention      Float     @default(0.9)

  user    User         @relation(fields: [userId], references: [id])
  session StudySession @relation(fields: [sessionId], references: [id])
  concept Concept?     @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  reviews CardReview[]

  @@index([userId])
  @@index([sessionId])
  @@index([conceptId])
  @@index([userId, nextReviewAt])
}

model Concept {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId           String   @db.Uuid
  name               String
  normalizedName     String
  description        String?
  standardFramework  String?
  standardCode       String?
  gradeBand          String?
  domain             String?
  academicStandardId String?  @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  course            Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  flashcards        Flashcard[]
  masteries         ConceptMastery[]
  tutorMessages     TutorMessage[]
  quizResults       QuizConceptResult[]
  diagnosticResults DiagnosticConceptResult[]
  prerequisites     ConceptPrerequisite[]     @relation("ConceptPrerequisites")
  supports          ConceptPrerequisite[]     @relation("PrerequisiteConcepts")
  evidence          MasteryEvidence[]
  academicStandard  AcademicStandard?         @relation(fields: [academicStandardId], references: [id], onDelete: SetNull)

  @@unique([courseId, normalizedName])
  @@index([courseId])
  @@index([standardFramework, standardCode])
  @@index([academicStandardId])
}

model AcademicStandard {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  framework   String
  version     String
  code        String
  uri         String?
  title       String
  description String?
  gradeBand   String?
  subject     String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  concepts Concept[]
  outgoing StandardAssociation[] @relation("StandardSource")
  incoming StandardAssociation[] @relation("StandardTarget")

  @@unique([framework, version, code])
  @@index([subject, gradeBand])
}

model StandardAssociation {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId String @db.Uuid
  targetId String @db.Uuid
  type     String
  metadata Json?

  source AcademicStandard @relation("StandardSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target AcademicStandard @relation("StandardTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([targetId, type])
}

model ConceptPrerequisite {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conceptId      String   @db.Uuid
  prerequisiteId String   @db.Uuid
  strength       Float    @default(1)
  source         String   @default("INFERRED")
  createdAt      DateTime @default(now())

  concept      Concept @relation("ConceptPrerequisites", fields: [conceptId], references: [id], onDelete: Cascade)
  prerequisite Concept @relation("PrerequisiteConcepts", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([conceptId, prerequisiteId])
  @@index([prerequisiteId])
}

model Classroom {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId      String    @db.Uuid
  organizationId String?   @db.Uuid
  name           String
  subject        String
  gradeBand      String
  joinCode       String    @unique
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  teacher      User                  @relation("ClassroomTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  organization Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  memberships  ClassroomMembership[]
  assignments  Assignment[]

  @@index([teacherId, archivedAt])
  @@index([organizationId, archivedAt])
}

model ClassroomMembership {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classroomId String   @db.Uuid
  studentId   String   @db.Uuid
  status      String   @default("ACTIVE")
  joinedAt    DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classroomId, studentId])
  @@index([studentId, status])
}

model GuardianInvite {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guardianId String    @db.Uuid
  code       String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  guardian User @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([guardianId, expiresAt])
}

model GuardianStudent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guardianId   String   @db.Uuid
  studentId    String   @db.Uuid
  relationship String   @default("Guardian")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())

  guardian User @relation("GuardianLinks", fields: [guardianId], references: [id], onDelete: Cascade)
  student  User @relation("StudentGuardians", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([studentId, status])
}

model Assignment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classroomId    String    @db.Uuid
  teacherId      String    @db.Uuid
  title          String
  instructions   String?
  targetConcepts Json?
  dueAt          DateTime?
  createdAt      DateTime  @default(now())

  classroom   Classroom              @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacher     User                   @relation("AssignmentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([classroomId, dueAt])
  @@index([teacherId])
}

model AssignmentSubmission {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId String    @db.Uuid
  studentId    String    @db.Uuid
  status       String    @default("ASSIGNED")
  score        Float?
  submittedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId, status])
}

model DiagnosticAssessment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @db.Uuid
  courseId        String?   @db.Uuid
  gradeBand       String
  subject         String
  status          String    @default("IN_PROGRESS")
  questions       Json
  responses       Json      @default("[]")
  abilityEstimate Float     @default(0.5)
  summary         Json?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course?                   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  conceptResults DiagnosticConceptResult[]

  @@index([userId, status, startedAt])
  @@index([courseId])
}

model DiagnosticConceptResult {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId     String @db.Uuid
  conceptId        String @db.Uuid
  correctCount     Int
  totalCount       Int
  estimatedMastery Float

  assessment DiagnosticAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  concept    Concept              @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, conceptId])
  @@index([conceptId])
}

model ConceptMastery {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @db.Uuid
  conceptId        String    @db.Uuid
  score            Float     @default(0)
  confidence       Float     @default(0)
  status           String    @default("NEW")
  attempts         Int       @default(0)
  correctCount     Int       @default(0)
  incorrectCount   Int       @default(0)
  uncertainty      Float     @default(1)
  memoryStability  Float     @default(1)
  memoryDifficulty Float     @default(5)
  guessRate        Float     @default(0.2)
  slipRate         Float     @default(0.1)
  learningRate     Float     @default(0.15)
  forgettingRate   Float     @default(0.04)
  lastEvidenceAt   DateTime?
  nextReviewAt     DateTime?
  lastPracticedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
  @@index([userId, status])
  @@index([conceptId])
  @@index([userId, nextReviewAt])
}

model MasteryEvidence {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @db.Uuid
  conceptId         String   @db.Uuid
  sourceType        String
  sourceId          String?
  correct           Boolean
  difficulty        Float    @default(0.5)
  responseTimeMs    Int?
  hintCount         Int      @default(0)
  independent       Boolean  @default(true)
  probabilityBefore Float
  probabilityAfter  Float
  createdAt         DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([conceptId, createdAt])
  @@index([sourceType, sourceId])
}

model CardReview {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @db.Uuid
  flashcardId    String   @db.Uuid
  sessionId      String?  @db.Uuid
  correct        Boolean
  responseTimeMs Int?
  hintCount      Int      @default(0)
  rating         Int?
  reviewedAt     DateTime @default(now())

  user      User          @relation(fields: [userId], references: [id])
  flashcard Flashcard     @relation(fields: [flashcardId], references: [id])
  session   StudySession? @relation(fields: [sessionId], references: [id])

  @@index([userId])
  @@index([flashcardId])
  @@index([sessionId])
}

model StudyStreak {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @unique @db.Uuid
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastStudyDate DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SavedQuiz {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @db.Uuid
  courseId         String?  @db.Uuid
  conversationId   String?  @db.Uuid
  sourceMaterialId String?  @db.Uuid
  title            String
  source           String?
  questions        Json
  score            Int?
  total            Int?
  createdAt        DateTime @default(now())

  user           User                @relation(fields: [userId], references: [id])
  course         Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  conversation   TutorConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  sourceMaterial SourceMaterial?     @relation(fields: [sourceMaterialId], references: [id], onDelete: SetNull)
  conceptResults QuizConceptResult[]

  @@index([userId])
  @@index([createdAt])
  @@index([courseId])
  @@index([conversationId])
  @@index([sourceMaterialId])
}

model TutorConversation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @db.Uuid
  courseId         String?  @db.Uuid
  sourceMaterialId String?  @db.Uuid
  title            String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  sourceMaterial SourceMaterial? @relation(fields: [sourceMaterialId], references: [id], onDelete: SetNull)
  messages       TutorMessage[]
  quizzes        SavedQuiz[]

  @@index([userId, updatedAt])
  @@index([courseId])
  @@index([sourceMaterialId])
}

model TutorMessage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String   @db.Uuid
  conceptId       String?  @db.Uuid
  role            String
  content         String
  attributionMode String   @default("GENERAL_KNOWLEDGE")
  citations       Json?
  createdAt       DateTime @default(now())

  conversation TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  concept      Concept?          @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([conceptId])
}

model SourceMaterial {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @db.Uuid
  courseId           String?  @db.Uuid
  title              String
  content            String
  sourceType         String
  originalFileName   String?
  mimeType           String?
  status             String   @default("READY")
  extractionMethod   String   @default("TEXT")
  contentHash        String?
  processingWarnings Json?
  metadata           Json?
  createdAt          DateTime @default(now())

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  studySessions StudySession[]
  conversations TutorConversation[]
  savedQuizzes  SavedQuiz[]
  chunks        SourceChunk[]

  @@index([userId, createdAt])
  @@index([courseId, createdAt])
}

model SourceChunk {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceMaterialId String   @db.Uuid
  chunkIndex       Int
  content          String
  contentHash      String
  locator          Json
  tokenEstimate    Int
  embedding        Json?
  createdAt        DateTime @default(now())

  sourceMaterial SourceMaterial @relation(fields: [sourceMaterialId], references: [id], onDelete: Cascade)

  @@unique([sourceMaterialId, chunkIndex])
  @@index([sourceMaterialId, chunkIndex])
  @@index([contentHash])
}

model QuizConceptResult {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  savedQuizId  String @db.Uuid
  conceptId    String @db.Uuid
  correctCount Int
  totalCount   Int

  savedQuiz SavedQuiz @relation(fields: [savedQuizId], references: [id], onDelete: Cascade)
  concept   Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([savedQuizId, conceptId])
  @@index([conceptId])
}

model Note {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  title     String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PrivacySettings {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                     String   @unique @db.Uuid
  aiPersonalizationEnabled   Boolean  @default(true)
  productAnalyticsEnabled    Boolean  @default(false)
  shareProgressWithTeachers  Boolean  @default(true)
  shareProgressWithGuardians Boolean  @default(true)
  tutorHistoryEnabled        Boolean  @default(true)
  dataRetentionDays          Int      @default(365)
  textScale                  String   @default("DEFAULT")
  reduceMotion               Boolean  @default(false)
  highContrast               Boolean  @default(false)
  readingFont                Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsentRecord {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectUserId   String    @db.Uuid
  grantedByUserId String    @db.Uuid
  consentType     String
  status          String
  noticeVersion   String
  grantedAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  subject   User @relation("ConsentSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  grantedBy User @relation("ConsentActor", fields: [grantedByUserId], references: [id], onDelete: Cascade)

  @@index([subjectUserId, consentType, status])
  @@index([grantedByUserId, createdAt])
}

model RoleVerification {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @db.Uuid
  requestedRole      String
  organizationName   String?
  organizationDomain String?
  status             String    @default("PENDING")
  reviewNote         String?
  createdAt          DateTime  @default(now())
  reviewedAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model SafetyEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?  @db.Uuid
  category      String
  severity      String
  action        String
  source        String
  contentHash   String?
  reviewSummary String?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([severity, createdAt])
}

model SafetyViolation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @db.Uuid
  category        String
  source          String
  ciphertext      String?
  iv              String?
  authTag         String?
  detailsPurgedAt DateTime?
  attemptNumber   Int
  lockoutUntil    DateTime?
  appealedAt      DateTime?
  resolution      String?
  createdAt       DateTime  @default(now())

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications SafetyNotification[]

  @@index([userId, createdAt])
  @@index([lockoutUntil])
}

model SafetyNotification {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId      String    @db.Uuid
  violationId          String    @db.Uuid
  recipientRole        String
  readAt               DateTime?
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?   @db.Uuid
  responseStatus       String    @default("UNACKNOWLEDGED")
  escalationLevel      Int       @default(0)
  lastEscalatedAt      DateTime?
  createdAt            DateTime  @default(now())

  recipient  User             @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  violation  SafetyViolation  @relation(fields: [violationId], references: [id], onDelete: Cascade)
  deliveries SafetyDelivery[]

  @@unique([recipientUserId, violationId])
  @@index([recipientUserId, readAt, createdAt])
  @@index([responseStatus, createdAt])
}

