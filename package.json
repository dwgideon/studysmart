{
  "name": "studysmart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/verify-build-environment.mjs && next build",
    "start": "next start",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.ts",
    "test:e2e:free": "node --env-file=.env scripts/e2e-ai-free.mjs",
    "pricing:model": "node scripts/pricing-model.mjs",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "check:security": "npm audit --omit=dev --audit-level=high && node scripts/security-scan.mjs",
    "check:production-env": "node --env-file=.env scripts/verify-production-readiness.mjs",
    "check:release": "npm run check:all && npm run check:security && npm run check:production-env",
    "lint": "eslint .",
    "check:knip": "knip",
    "check:tsprune": "ts-prune -p tsconfig.json",
    "check:deps": "depcheck --ignores='@types/*,eslint*,typescript,ts-node'",
    "check:mobile": "npm --prefix apps/mobile run lint && npm --prefix apps/mobile run typecheck",
    "build:mobile": "npm --prefix apps/mobile run test:bundle",
    "check:all": "npm run test && npm run build --silent && npm run check:knip && npm run check:tsprune && npm run check:deps"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/auth-helpers-react": "^0.5.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.55.0",
    "fast-xml-parser": "^5.10.0",
    "formidable": "^3.5.4",
    "jose": "^6.2.3",
    "jszip": "^3.10.1",
    "next": "^15.5.23",
    "openai": "^4.104.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "stripe": "^18.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.38.0",
    "@types/node": "^20.19.11",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/web-push": "^3.6.4",
    "depcheck": "^1.4.7",
    "eslint": "^9.38.0",
    "eslint-config-next": "^15.5.6",
    "eslint-plugin-unused-imports": "^4.3.0",
    "knip": "^5.66.0",
    "prisma": "^6.19.1",
    "ts-prune": "^0.10.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.3"
  }
}
